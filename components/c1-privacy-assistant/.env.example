# Copy to .env (never committed) and change the key. Load it with: set -a; source .env; set +a
MG_SERVICE_NAME=c1
# Callers C1 accepts, as name:key pairs. Only "gateway" may call /v1/* routes.
MG_ACCEPTED_KEYS=gateway:change-me
C1_NAME_THRESHOLD=0.65
# Optional overrides (defaults are inside this component folder)
# C1_MODEL_PATH=models/c1_model.joblib
# C1_MODEL_MANIFEST=models/manifest.json
# C1_CONFIG_FOLDER=configs
