# Copy to .env for local runs. Never commit .env.

MG_SERVICE_NAME=c2
MG_SERVICE_KEY=rp20206c02servicekey
MG_ACCEPTED_KEYS=gateway:rp20206c02gatewaykey
MG_C4_URL=http://127.0.0.1:8004
MG_OUTBOX_PATH=./data/c2.db

C2_MODEL_VERSION=c2-electra-small-v0
C2_CLASSIFIER_CHECKPOINT_PATH=
C2_CHROMA_DIR=./data/chroma
C2_THRESHOLDS_FILE=./configs/thresholds.yaml
C2_ALLOW_UNAUTHENTICATED=true
C2_DEV_UI=true
C2_MAX_LENGTH=512
