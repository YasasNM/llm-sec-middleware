    {
      "cell_type": "code",
      "source": [
        "# Previously: 100% of filtered data went into train+val, leaving nothing for\n",
        "# real evaluation. Fix: carve out 20% of GROUPS first, untouched by anything\n",
        "# that follows, THEN split the remaining 80% into train/val.\n",
