# C4 settings. Copy this file to .env and change the values. Never commit .env.
# Caller keys: name:key pairs. C4 knows who is calling from the key.
MG_ACCEPTED_KEYS=c1:change-me-c1,c2:change-me-c2,c3:change-me-c3,gateway:change-me-gateway

# MongoDB (database name is the last part of the URL)
C4_MONGO_URL=mongodb://localhost:27017/c4

# Scoring rules file (all thresholds live here)
C4_RULES_FILE=configs/rules.yaml

# The browser dashboard and its demo buttons (true for the demo, false for anything else)
C4_DASHBOARD_ENABLED=true
