{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediguard/contracts/c1_check_response/1.0.0",
  "title": "C1 to gateway",
  "type": "object",
  "required": [
    "request_id",
    "decision",
    "masked_text",
    "placeholder_manifest",
    "masking_percentage",
    "entity_counts",
    "reid",
    "latency_ms"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "ACCESS_BLOCKED"
      ]
    },
    "masked_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "null when ACCESS_BLOCKED"
    },
    "placeholder_manifest": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[[A-Z_]+_[0-9]+\\]$"
      },
      "description": "Tokens only, never values"
    },
    "masking_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "entity_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "reid": {
      "type": "object",
      "required": [
        "level",
        "score",
        "applied"
      ],
      "properties": {
        "level": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "applied": {
          "type": "boolean"
        }
      }
    },
    "user_message_code": {
      "enum": [
        null,
        "ACCESS_BLOCKED"
      ]
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}