{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediguard/contracts/c2_classify_response/1.0.0",
  "title": "C2 to gateway",
  "type": "object",
  "required": [
    "request_id",
    "c2_verdict",
    "c2_score",
    "method",
    "degraded",
    "latency_ms",
    "model_version"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "c2_verdict": {
      "enum": [
        "PASS",
        "BLOCK"
      ]
    },
    "c2_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "method": {
      "enum": [
        "similarity_override",
        "ensemble",
        "fail_safe"
      ]
    },
    "nearest_attack_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "degraded": {
      "type": "boolean",
      "description": "true when one branch failed and the other decided alone"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "model_version": {
      "type": "string"
    }
  }
}