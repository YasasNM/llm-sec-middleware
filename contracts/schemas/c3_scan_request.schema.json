{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediguard/contracts/c3_scan_request/1.0.0",
  "title": "Gateway to C3: POST /v1/scan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "org_id",
    "user_id",
    "session_id",
    "response_text",
    "placeholder_manifest"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "org_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "response_text": {
      "type": "string",
      "maxLength": 50000
    },
    "placeholder_manifest": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\[[A-Z_]+_[0-9]+\\]$"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional category filter for retrieval (for example prescribing, data_handling)"
    }
  }
}