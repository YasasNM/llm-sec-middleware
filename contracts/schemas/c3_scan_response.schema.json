{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mediguard/contracts/c3_scan_response/1.0.0",
  "title": "C3 to gateway (PolicyVerdict)",
  "type": "object",
  "required": [
    "request_id",
    "c3_verdict",
    "clause_id",
    "cited_clauses",
    "leaked_pii_detected",
    "leaked_pii_count",
    "decision_source",
    "user_message_code",
    "clean_response",
    "latency_ms"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "c3_verdict": {
      "enum": [
        "CLEAN",
        "VIOLATION"
      ]
    },
    "clause_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cited_clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "clause_id",
          "doc_name",
          "title",
          "citation_status"
        ],
        "properties": {
          "clause_id": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          },
          "doc_name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "citation_status": {
            "enum": [
              "verified",
              "repaired_quote",
              "repaired_citation"
            ]
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "retrieval_rank": {
            "type": "integer"
          }
        }
      }
    },
    "leaked_pii_detected": {
      "type": "boolean"
    },
    "leaked_pii_count": {
      "type": "integer",
      "minimum": 0
    },
    "decision_source": {
      "enum": [
        "generator",
        "leak_check",
        "error_fail_closed"
      ]
    },
    "assurance": {
      "enum": [
        "high",
        "low"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ],
      "description": "Admins only, never shown to clinicians"
    },
    "user_message_code": {
      "enum": [
        null,
        "OUTPUT_WITHHELD"
      ]
    },
    "clean_response": {
      "type": [
        "string",
        "null"
      ],
      "description": "Filled only when CLEAN"
    },
    "policy_index_version": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "retriever_version": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Total scan time"
    },
    "latency_breakdown_ms": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Optional stage times: retrieve, encode, verdict_step, decode, verify, leak"
    },
    "leak_check": {
      "type": "object",
      "description": "Entity types and offsets only, never values"
    },
    "generation": {
      "type": "object",
      "description": "mode, p_violation, tau, decoded, output_tokens"
    }
  }
}